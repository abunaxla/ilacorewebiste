# On the VPS, .env must be plain KEY=value lines: no "export", no inline comments, no multi-line values.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SITE_URL=https://ilacore.com

# Test-only: leave both empty in production (remote-deploy.sh refuses to build otherwise).
# LEAD_TRANSPORT: only 'mock' is meant for tests; empty means Resend.
# LEAD_RATE_LIMIT: an empty or invalid value falls back to 5 requests per 10 minutes per IP.
LEAD_TRANSPORT=
LEAD_RATE_LIMIT=
